<section class="cart-page">

  <div class="container">

    <h1>Your Cart</h1>

    {% if cart.item_count > 0 %}

      <form action="{{ routes.cart_url }}" method="post">

        {% for item in cart.items %}

          <div class="cart-item">

            <div class="cart-product">

              {% if item.image %}

                <img
                  src="{{ item.image | image_url: width: 150 }}"
                  alt="{{ item.product.title | escape }}"
                  width="90"
                  height="110"
                >

              {% endif %}

              <div>

                <h2>
                  {{ item.product.title }}
                </h2>

                <p>
                  {{ item.final_price | money }}
                </p>

              </div>

            </div>


            <div class="cart-quantity">

              <label for="quantity-{{ item.key }}">
                Quantity
              </label>

              <input
                type="number"
                id="quantity-{{ item.key }}"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
              >

            </div>


            <p class="cart-total">
              {{ item.final_line_price | money }}
            </p>


            <a
              href="{{ item.url_to_remove }}"
              class="remove-item"
            >
              Remove
            </a>

          </div>

        {% endfor %}


        <hr>


        <h2>
          Total: {{ cart.total_price | money }}
        </h2>


        <button
          type="submit"
          name="update"
        >
          Update Cart
        </button>


        <button
          type="submit"
          name="checkout"
        >
          Checkout →
        </button>

      </form>


    {% else %}

      <h2>
        Your cart is empty 🛒
      </h2>

      <a href="{{ routes.root_url }}">
        Continue Shopping
      </a>

    {% endif %}

  </div>

</section>


{% schema %}

{
  "name": "Main Cart",
  "settings": []
}

{% endschema %}